{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "proposed.group-error.v1"
    },
    "implementation_status": {
      "const": "proposed_not_implemented"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "enum": [
        "component-1",
        "component-3",
        "gateway"
      ]
    },
    "code": {
      "enum": [
